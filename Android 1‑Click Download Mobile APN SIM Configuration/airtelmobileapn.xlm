<ESIMProfile xmlns="urn:gsma:esim:profile:1.0">
  <ProfileMetadata>
    <ProfileName>Airtel Digital Platforms (Mumbai)</ProfileName>
    <ProfileIdentifier>COM.AIRTEL.APNPROFILE.ANDROID</ProfileIdentifier>
    <ProfileVersion>1</ProfileVersion>
    <ProfileUUID>550E8400-E29B-41D4-A716-446655440021</ProfileUUID>
    <ProfileDisplayName>Airtel APN (Android)</ProfileDisplayName>
  </ProfileMetadata>

  <APNConfiguration>
    <APN>airtelgprs.com</APN>
    <Username>guest</Username>
    <Password>guest</Password>
    <Server>enterprise.airtel.com,qos.airtel.com,priority.services.net</Server>
    <MMSC>http://mmsc.airtelworld.com</MMSC>
    <MMSProxy>100.1.201.171</MMSProxy>
    <MMSPort>8799</MMSPort>
    <MCC>404</MCC>
    <MNC>20</MNC>
    <Authentication>CHAP</Authentication>
    <APNType>default,supl,xcap,net,ia,hipri,mms,wap,fota,cbs,mcx,emergency,dun,ims,omadm</APNType>
    <Protocol>IPV4V6</Protocol>
    <RoamingProtocol>IPV4V6</RoamingProtocol>
    <Bearer>LTE,NR,LTE-CA,HSPA+</Bearer>
  </APNConfiguration>

  <eSIMSettings>
    <MaxProfiles>20</MaxProfiles>
    <ActiveProfiles>5</ActiveProfiles>
    <Compliance>GSMA-SGP.32-Full;GSMA-SGP.32-Enhanced;GSMA-SGP.32-GovSec;GSMA-SGP.32-CarrierGrade</Compliance>
    <ProvisioningMode>Remote,Local,Hybrid</ProvisioningMode>
    <TLSVersion>1.3</TLSVersion>
    <PostQuantumReady>true</PostQuantumReady>
    <PolicySwitching>true</PolicySwitching>
    <DISA_STIG>true</DISA_STIG>
    <NATO_IATA>true</NATO_IATA>
    <GovNet>true</GovNet>
    <SLAProfile>true</SLAProfile>
    <MultiIMSI>true</MultiIMSI>
    <RoamingAgreements>Enabled</RoamingAgreements>
    <CarrierID>AirtelCluster01</CarrierID>
    <IndiaCompliance>true</IndiaCompliance>
    <UAECompliance>true</UAECompliance>
  </eSIMSettings>
</ESIMProfile>
